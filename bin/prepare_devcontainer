#!/usr/bin/env ruby
require "fileutils"
require "json"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def set_env_var(key, value, env_file = ".env" , secret = false)
  env_path = File.join(APP_ROOT, env_file)
  env_content = File.exist?(env_path) ? File.read(env_path) : ""

  # Remove existing line with this key (if any)
  env_content = env_content.lines.reject { |line| line.strip.start_with?("#{key}=") }.join

  # Add or update the environment variable
  env_content += "#{key}=#{value}\n"

  File.write(env_path, env_content)
  if secret
    puts "Set #{key} in #{env_file} as secret value"
  else
    puts "Set #{key} in #{env_file} as #{value}"
  end
end

def update_vite_config(public_output_dir)
  vite_config_path = File.join(APP_ROOT, "config", "vite.json")
  vite_config = JSON.parse(File.read(vite_config_path))

  vite_config["development"] ||= {}
  vite_config["development"]["publicOutputDir"] = public_output_dir

  File.write(vite_config_path, JSON.pretty_generate(vite_config))
  puts "Updated config/vite.json with publicOutputDir: #{public_output_dir}"
end

def set_git_config_from_env
  puts "== Setting git config from environment variables =="

  if ENV["CODER_GIT_AUTHOR_NAME"]
    system!("git", "config", "--global", "user.name", ENV["CODER_GIT_AUTHOR_NAME"])
    # puts "Set git user.name to #{ENV['CODER_GIT_AUTHOR_NAME']}"
  end

  if ENV["CODER_GIT_AUTHOR_EMAIL"]
    system!("git", "config", "--global", "user.email", ENV["CODER_GIT_AUTHOR_EMAIL"])
    # puts "Set git user.email to #{ENV['CODER_GIT_AUTHOR_EMAIL']}"
  end

  if ENV["CODER_GIT_COMMITTER_NAME"]
    set_env_var("GIT_COMMITTER_NAME", ENV["CODER_GIT_COMMITTER_NAME"])
    # puts "Set GIT_COMMITTER_NAME environment variable"
  end

  if ENV["CODER_GIT_COMMITTER_EMAIL"]
    set_env_var("GIT_COMMITTER_EMAIL", ENV["CODER_GIT_COMMITTER_EMAIL"])
    # puts "Set GIT_COMMITTER_EMAIL environment variable"
  end
end

FileUtils.chdir APP_ROOT do

  puts "== Setting up environment =="
  # Example: Set environment variables that persist across shell sessions
  # Uncomment and modify as needed:
  running_in_code_server = ENV["PATH"]&.include?("/code-server")

  if running_in_code_server
    puts "== Detected Code Server environment =="
    set_env_var("RUNNING_IN_CODE_SERVER", "true")
    set_git_config_from_env


    public_output_dir = "@#{ENV.fetch('CODER_WORKSPACE_OWNER_NAME')}/#{ENV.fetch('CODER_WORKSPACE_NAME')}.#{ENV.fetch('CODER_WORKSPACE_NAME')}/apps/#{ENV.fetch('CODER_WORKSPACE_SLUG')}/absproxy/#{ENV.fetch('PORT', 3000)}/vite-dev"
    set_env_var("VITE_DEV_PUBLIC_OUTPUT_DIR", public_output_dir)
    update_vite_config(public_output_dir)

    api_base_url = "/@#{ENV.fetch('CODER_WORKSPACE_OWNER_NAME')}/#{ENV.fetch('CODER_WORKSPACE_NAME')}.#{ENV.fetch('CODER_WORKSPACE_NAME')}/apps/#{ENV.fetch('CODER_WORKSPACE_SLUG')}/proxy/#{ENV.fetch('PORT', 3000)}"
    set_env_var("VITE_BASE_URL", api_base_url)

    set_env_var("ASSET_HOST", ENV.fetch("CODER_AGENT_URL"))
  end

  running_in_container = ENV["RUNNING_IN_CONTAINER"] == "true" || ENV["CODER"] == "true"

  if running_in_container
    puts "== Changing cache directories for contenerized environment =="
    set_env_var("YARN_CACHE_FOLDER", ".yarn/cache")
    puts "== Setting bundle cache directory to .bundle/gems =="
    system!("bundle config set --local path .bundle/gems")
  end


end
