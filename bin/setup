#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# Helper method to check if a command is available
def command_available?(cmd)
  system("which #{cmd} > /dev/null 2>&1")
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="

  # Check if mise is available
  if command_available?("mise")
    system!("mise install")
  else
    # If mise is not available, check for node and ruby
    unless command_available?("node") && command_available?("ruby")
      $stderr.puts "Error: mise is not available, and required tools (node and ruby) are missing."
      $stderr.puts "Please install mise or ensure node and ruby are available in your PATH."
      exit 1
    end
    # If node and ruby are available, continue without mise
  end

  system!("corepack install") && system!("corepack enable yarn") && system!("corepack yarn")

  system("bundle check") || system!("bundle install")

  # puts "\n== Copying sample files =="
  unless File.exist?("config/database.yml")
    FileUtils.cp "config/database.yml.sample", "config/database.yml"
  end

  puts "\n== Preparing database =="
  system! "bundle exec rails db:prepare"
  system! "bundle exec rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bundle exec rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    puts "Starting Rails server and Vite dev server with Foreman..."
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
