// For format details, see https://containers.dev/implementors/json_reference/.
// For config options, see the README at: https://github.com/devcontainers/templates/tree/main/src/ruby
{
  "name": "recruitment-challenge",
  "dockerComposeFile": "compose.yaml",
  "service": "rails-app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    // "ghcr.io/devcontainers/features/github-cli:1": {},
    // "ghcr.io/rails/devcontainer/features/activestorage": {},
    // "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
    //   "moby": false
    // },
    /// "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // "ghcr.io/rails/devcontainer/features/postgres-client:1.1.3": {
    //   "version": "18.1"
    // },
    "ghcr.io/devcontainers-extra/features/mise:1": {},
    "ghcr.io/devcontainers-extra/features/corepack:1": {},
    "ghcr.io/coder/devcontainer-features/code-server:1": {
      "port": 13337,
      "host": "0.0.0.0",
      "disableTelemetry": true,
      "disableUpdateCheck": true,
      "disableFileUploads": true,
      "disableFileDownloads": true,
      "workspace": "/workspaces/${localWorkspaceFolderBasename}",
      "absProxyBasePath": "/@${localEnv:CODER_WORKSPACE_OWNER_NAME}/${localEnv:CODER_WORKSPACE_NAME}.${localEnv:CODER_WORKSPACE_NAME}/apps/${localEnv:CODER_WORKSPACE_SLUG}",
      "auth": "none",
      "appName": "Enginearch Recruitment Challenge",
      "welcomeText": "Welcome to the Enginearch Recruitment Challenge",
      "extensions": [
        "Shopify.ruby-lsp",
        "Vue.volar",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig",
        "rubocop.vscode-rubocop",
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "rebornix.ruby",
        "NicholasHsiang.vscode-vue3-snippets",
        "Cardinal90.multi-cursor-case-preserve",
        "yzhang.markdown-all-in-one",
        "anweber.vscode-httpyac"
      ]
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true
    }
  },
  "appPort": ["13337:13337"],
  "containerEnv": {
    "ABS_PROXY_BASE_PATH": "/@${localEnv:CODER_WORKSPACE_OWNER_NAME}/${localEnv:CODER_WORKSPACE_NAME}.${localEnv:CODER_WORKSPACE_NAME}/apps/${localEnv:CODER_WORKSPACE_SLUG}",
    "CAPYBARA_SERVER_PORT": "45678",
    "SELENIUM_HOST": "selenium",
    "KAMAL_REGISTRY_PASSWORD": "$KAMAL_REGISTRY_PASSWORD",
    "PGHOST": "postgres",
    "PGPASSWORD": "postgres",
    "PGUSER": "postgres",
    "CODER_WORKSPACE_AGENT_NAME": "${localEnv:CODER_WORKSPACE_AGENT_NAME}",
    "CODER_WORKSPACE_NAME": "${localEnv:CODER_WORKSPACE_NAME}",
    "CODER_AGENT_TOKEN": "${localEnv:CODER_AGENT_TOKEN}",
    "CODER_AGENT_URL": "${localEnv:CODER_AGENT_URL}",
    "CODER_WORKSPACE_OWNER_NAME": "${localEnv:CODER_WORKSPACE_OWNER_NAME}",
    "CODER_WORKSPACE_FOLDER_NAME": "${localWorkspaceFolderBasename}",
    "CODER_GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "CODER_GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
    "CODER_GIT_COMMITTER_NAME": "${localEnv:GIT_COMMITTER_NAME}",
    "CODER_GIT_COMMITTER_EMAIL": "${localEnv:GIT_COMMITTER_EMAIL}",
    "CODER_TEMPLATE_ID": "${localEnv:CODER_TEMPLATE_ID}",
    "CODER_TEMPLATE_NAME": "${localEnv:CODER_TEMPLATE_NAME}",
    "CODER_TEMPLATE_VERSION": "${localEnv:CODER_TEMPLATE_VERSION}",
    "CODER_WORKSPACE_SLUG": "${localEnv:CODER_WORKSPACE_SLUG}",
    "RUNNING_IN_CONTAINER": "true"
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [3000, 5432],

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "Vue.volar",
        "esbenp.prettier-vscode",
        "EditorConfig.EditorConfig",
        "rubocop.vscode-rubocop",
        "mhutchie.git-graph",
        "eamodio.gitlens",
        "rebornix.ruby",
        "NicholasHsiang.vscode-vue3-snippets",
        "redhat.vscode-yaml",
        "Cardinal90.multi-cursor-case-preserve",
        "yzhang.markdown-all-in-one",
        "anweber.vscode-httpyac"
      ]
    },
    "coder": {
      "name": "${localEnv:CODER_WORKSPACE_NAME}"
    }
  },

  // Uncomment to connect as root instead. More info: https://containers.dev/implementors/json_reference/#remoteUser.
  // "remoteUser": "root",

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "bin/prepare_devcontainer && bin/setup --skip-server"
}
